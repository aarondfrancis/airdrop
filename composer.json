{
    "name": "wilbergroup/airdrop",
    "description": "A Laravel package to deploy your application faster by skipping asset compilation when possible.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Aaron Francis",
            "email": "aaron@tryhardstudios.com"
        },
        {
            "name": "Jacob Bennett",
            "homepage": "https://x.com/jacobbennett"
        }
    ],
    "replace": {
        "aaronfrancis/airdrop": "self.version"
    },
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/filesystem": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/console": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^8.21|^9.2|^10.0|^11.0",
        "phpunit/phpunit": "^10.5|^11.0"
    },
    "autoload": {
        "psr-4": {
            "WilberGroup\\Airdrop\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WilberGroup\\Airdrop\\Tests\\": "tests/"
        }
    },
    "support": {
        "issues": "https://github.com/WilberGroup/airdrop/issues",
        "source": "https://github.com/WilberGroup/airdrop"
    },
    "extra": {
        "laravel": {
            "providers": [
                "WilberGroup\\Airdrop\\AirdropServiceProvider"
            ]
        }
    }
}
